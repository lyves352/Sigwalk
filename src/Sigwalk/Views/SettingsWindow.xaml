<Window x:Class="Sigwalk.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Sigwalk.Converters"
        xmlns:loc="clr-namespace:Sigwalk.Localization"
        Title="{loc:Tr Window.Settings.Title}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Window.Resources>
    <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
  </Window.Resources>

  <ScrollViewer MaxHeight="780" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18">
      <TextBlock Text="{loc:Tr Settings.ScanSection}" Style="{StaticResource SectionTitleStyle}" />

      <CheckBox Content="{loc:Tr Settings.Recursive}" IsChecked="{Binding Recursive}" Margin="0,0,0,10" />

      <TextBlock Text="{loc:Tr Settings.Extensions}"
                 Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
      <TextBox Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}"
               Margin="0,0,0,12" />

      <TextBlock Text="{loc:Tr Settings.Concurrency}"
                 Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
      <TextBox Text="{Binding MaxConcurrencyText, UpdateSourceTrigger=PropertyChanged}"
               Width="100" HorizontalAlignment="Left" Margin="0,0,0,12" />

      <TextBlock Text="{loc:Tr Settings.ScanMode}"
                 Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
      <ComboBox ItemsSource="{Binding ScanModeOptions}"
                DisplayMemberPath="Display"
                SelectedItem="{Binding SelectedScanMode}"
                Margin="0,0,0,12" />

      <TextBlock Text="{loc:Tr Settings.Revocation}"
                 Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
      <ComboBox ItemsSource="{Binding RevocationOptions}"
                DisplayMemberPath="Display"
                SelectedItem="{Binding SelectedRevocation}"
                Margin="0,0,0,4" />
      <TextBlock Text="{loc:Tr Settings.RevocationHint}"
                 Foreground="{DynamicResource MutedForegroundBrush}"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Margin="0,0,0,12" />

      <CheckBox Content="{loc:Tr Settings.AutoSort}"
                IsChecked="{Binding AutoSortAfterScan}"
                Margin="0,0,0,16" />

      <TextBlock Text="{loc:Tr Settings.ExportSection}" Style="{StaticResource SectionTitleStyle}" />

      <TextBlock Text="{loc:Tr Settings.ExportFormat}"
                 Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
      <ComboBox ItemsSource="{Binding ExportFormatOptions}"
                DisplayMemberPath="Display"
                SelectedItem="{Binding SelectedExportFormat}"
                Margin="0,0,0,12" />

      <TextBlock Text="{loc:Tr Settings.ExportContent}"
                 Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <RadioButton Content="{loc:Tr Settings.Export.All}"
                     GroupName="ExportContent"
                     IsChecked="{Binding ExportContentAll, Mode=TwoWay}"
                     Margin="0,0,18,0" />
        <RadioButton Content="{loc:Tr Settings.Export.Compact}"
                     GroupName="ExportContent"
                     IsChecked="{Binding ExportContentCompact, Mode=TwoWay}" />
      </StackPanel>
      <TextBlock Text="{loc:Tr Settings.Export.CompactHint}"
                 Foreground="{DynamicResource MutedForegroundBrush}"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Margin="0,0,0,16" />

      <TextBlock Text="{loc:Tr Settings.InterfaceSection}" Style="{StaticResource SectionTitleStyle}" />

      <TextBlock Text="{loc:Tr Settings.Theme}"
                 Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
      <ComboBox ItemsSource="{Binding ThemeOptions}"
                DisplayMemberPath="Display"
                SelectedItem="{Binding SelectedTheme}"
                Margin="0,0,0,12" />

      <TextBlock Text="{loc:Tr Settings.Language}"
                 Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
      <ComboBox ItemsSource="{Binding LanguageOptions}"
                DisplayMemberPath="Display"
                SelectedItem="{Binding SelectedLanguage}"
                Margin="0,0,0,16" />

      <TextBlock Text="{loc:Tr Settings.ColumnsSection}" Style="{StaticResource SectionTitleStyle}" />
      <TextBlock Text="{loc:Tr Settings.ColumnsHint}"
                 Foreground="{DynamicResource MutedForegroundBrush}"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Margin="0,0,0,8" />

      <ItemsControl ItemsSource="{Binding Columns}" Margin="0,0,0,12">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox Content="{Binding Display}"
                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                      Margin="0,0,20,8" Width="150" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding ValidationMessage}"
                 Foreground="{DynamicResource ErrorBrush}"
                 TextWrapping="Wrap"
                 Margin="0,4,0,0"
                 Visibility="{Binding ValidationMessage, Converter={StaticResource NotEmptyToVisibility}}" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="{loc:Tr Common.Cancel}" IsCancel="True" Click="Cancel_Click" />
        <Button Content="{loc:Tr Common.Ok}" IsDefault="True" Style="{StaticResource AccentButtonStyle}"
                Click="Ok_Click" Margin="0" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
