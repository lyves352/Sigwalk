<Window x:Class="Sigwalk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Sigwalk.Converters"
        xmlns:loc="clr-namespace:Sigwalk.Localization"
        xmlns:helpers="clr-namespace:Sigwalk.Helpers"
        xmlns:models="clr-namespace:Sigwalk.Core.Models;assembly=Sigwalk.Core"
        Title="{loc:Tr App.Title}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Width="1500"
        Height="820"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Loaded="Window_Loaded"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFilesCommand}" />
    <KeyBinding Key="O" Modifiers="Ctrl+Shift" Command="{Binding OpenDirectoryCommand}" />
    <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PastePathsCommand}" />
    <KeyBinding Key="F5" Command="{Binding StartScanCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CancelScanCommand}" />
    <KeyBinding Key="Delete" Command="{Binding RemoveSelectedCommand}" />
    <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopySelectedCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveResultsCommand}" />
  </Window.InputBindings>

  <Window.Resources>
    <conv:SignatureStatusToBrushConverter x:Key="SignatureStatusBrush" />
    <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility" />
    <conv:EmptyToDashConverter x:Key="EmptyToDash" />

    <Style x:Key="ColumnHeaderStyle"
           TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource DataGridColumnHeaderBaseStyle}">
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="ColumnHeader_PreviewMouseRightButtonDown" />
    </Style>

    <Style x:Key="PathCellStyle" TargetType="TextBlock">
      <Setter Property="ToolTip" Value="{Binding FilePath}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ShaCellStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
    </Style>

    <Style x:Key="TruncatedCellStyle" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
    </Style>

    <Style x:Key="SignatureStatusCellStyle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground"
              Value="{Binding SignatureStatus, Converter={StaticResource SignatureStatusBrush}}" />
      <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
    </Style>

    <Style x:Key="ScanStatusCellStyle" TargetType="TextBlock">
      <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
    </Style>
  </Window.Resources>

  <DockPanel>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{loc:Tr Menu.File}">
        <MenuItem Header="{loc:Tr Menu.File.OpenFiles}" Command="{Binding OpenFilesCommand}"
                  InputGestureText="Ctrl+O" />
        <MenuItem Header="{loc:Tr Menu.File.OpenDirectory}" Command="{Binding OpenDirectoryCommand}"
                  InputGestureText="Ctrl+Shift+O" />
        <Separator />
        <MenuItem Header="{loc:Tr Menu.File.AddFiles}" Command="{Binding AddFilesCommand}" />
        <MenuItem Header="{loc:Tr Menu.File.AddDirectory}" Command="{Binding AddDirectoryCommand}" />
        <MenuItem Header="{loc:Tr Menu.File.PastePaths}" Command="{Binding PastePathsCommand}"
                  InputGestureText="Ctrl+V" />
        <Separator />
        <MenuItem Header="{loc:Tr Menu.File.SaveResults}" Command="{Binding SaveResultsCommand}"
                  InputGestureText="Ctrl+S" />
        <MenuItem Header="{loc:Tr Menu.File.Import}" Command="{Binding LoadResultsCommand}" />
        <MenuItem Header="{loc:Tr Menu.File.Export}" Command="{Binding ExportCommand}" />
        <MenuItem Header="{loc:Tr Menu.File.ExportFiltered}" Command="{Binding ExportFilteredCommand}" />
        <Separator />
        <MenuItem Header="{loc:Tr Menu.File.ClearList}" Command="{Binding ClearListCommand}" />
        <Separator />
        <MenuItem Header="{loc:Tr Menu.File.Exit}" Command="{Binding ExitCommand}" />
      </MenuItem>

      <MenuItem Header="{loc:Tr Menu.Scan}">
        <MenuItem Header="{loc:Tr Menu.Scan.Start}" Command="{Binding StartScanCommand}"
                  InputGestureText="F5" />
        <MenuItem Header="{loc:Tr Menu.Scan.Cancel}" Command="{Binding CancelScanCommand}"
                  InputGestureText="Esc" />
        <Separator />
        <MenuItem Header="{loc:Tr Menu.Scan.Rescan}" Command="{Binding RescanSelectedCommand}" />
        <MenuItem Header="{loc:Tr Menu.Scan.RemoveSelected}" Command="{Binding RemoveSelectedCommand}"
                  InputGestureText="Delete" />
      </MenuItem>

      <MenuItem Header="{loc:Tr Menu.View}">
        <MenuItem Header="{loc:Tr Menu.View.Theme}">
          <MenuItem Header="{loc:Tr Menu.View.Theme.Auto}"
                    IsCheckable="False"
                    IsChecked="{Binding IsAutoTheme, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}"
                    CommandParameter="{x:Static models:ThemeMode.Auto}" />
          <MenuItem Header="{loc:Tr Menu.View.Theme.Light}"
                    IsCheckable="False"
                    IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}"
                    CommandParameter="{x:Static models:ThemeMode.Light}" />
          <MenuItem Header="{loc:Tr Menu.View.Theme.Dark}"
                    IsCheckable="False"
                    IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}"
                    CommandParameter="{x:Static models:ThemeMode.Dark}" />
        </MenuItem>
        <MenuItem Header="{loc:Tr Menu.View.Language}">
          <MenuItem Header="{loc:Tr Menu.View.Language.Chinese}"
                    IsCheckable="False"
                    IsChecked="{Binding IsChineseLanguage, Mode=OneWay}"
                    Command="{Binding SetLanguageCommand}"
                    CommandParameter="{x:Static models:AppLanguage.Chinese}" />
          <MenuItem Header="{loc:Tr Menu.View.Language.English}"
                    IsCheckable="False"
                    IsChecked="{Binding IsEnglishLanguage, Mode=OneWay}"
                    Command="{Binding SetLanguageCommand}"
                    CommandParameter="{x:Static models:AppLanguage.English}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="{loc:Tr Menu.View.Settings}" Command="{Binding ShowSettingsCommand}" />
      </MenuItem>

      <MenuItem Header="{loc:Tr Menu.Help}">
        <MenuItem Header="{loc:Tr Menu.Help.OpenLogFolder}" Command="{Binding OpenLogFolderCommand}" />
        <MenuItem Header="{loc:Tr Menu.Help.About}" Command="{Binding ShowAboutCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,7">
      <WrapPanel VerticalAlignment="Center">
        <Button Content="{loc:Tr Toolbar.OpenFiles}" Command="{Binding OpenFilesCommand}" />
        <Button Content="{loc:Tr Toolbar.OpenDirectory}" Command="{Binding OpenDirectoryCommand}" />
        <Border Width="1" Height="20" Margin="4,0,10,0" VerticalAlignment="Center"
                Background="{DynamicResource BorderBrush}" />
        <Button Content="{Binding ScanActionText}" Command="{Binding ScanActionCommand}"
                Style="{StaticResource AccentButtonStyle}" MinWidth="96" />
        <Button Content="{loc:Tr Menu.Scan.Rescan}" Command="{Binding RescanSelectedCommand}" />
        <Button Content="{loc:Tr Menu.File.ClearList}" Command="{Binding ClearListCommand}" />
        <Border Width="1" Height="20" Margin="4,0,10,0" VerticalAlignment="Center"
                Background="{DynamicResource BorderBrush}" />
        <Button Content="{loc:Tr Toolbar.Export}" Command="{Binding ExportCommand}" />
        <Button Content="{loc:Tr Toolbar.Import}" Command="{Binding LoadResultsCommand}" />
        <Button Content="{loc:Tr Toolbar.Settings}" Command="{Binding ShowSettingsCommand}" />
        <Border Width="1" Height="20" Margin="4,0,10,0" VerticalAlignment="Center"
                Background="{DynamicResource BorderBrush}" />
        <CheckBox Content="{loc:Tr Toolbar.Recursive}" IsChecked="{Binding Recursive}"
                  Margin="2,0,12,0" VerticalAlignment="Center" />
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="{loc:Tr Filter.SignatureStatus}" Style="{StaticResource CaptionTextStyle}" />
        <ComboBox Width="130" Margin="0,0,12,0"
                  ItemsSource="{Binding FilterOptions}"
                  DisplayMemberPath="Display"
                  SelectedItem="{Binding SelectedFilter}" />
        <TextBlock Text="{loc:Tr Filter.Search}" Style="{StaticResource CaptionTextStyle}" />
        <TextBox x:Name="SearchBox" Width="300" Margin="0,0,8,0"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{loc:Tr Filter.SearchTooltip}" />
        <Button Content="{loc:Tr Filter.Clear}" Command="{Binding ClearFiltersCommand}" />
        <TextBlock Text="{Binding VisibleCountText}"
                   Style="{StaticResource CaptionTextStyle}"
                   Margin="12,0,0,0" />
        <Border Width="1" Height="18" Margin="12,0,12,0" VerticalAlignment="Center"
                Background="{DynamicResource BorderBrush}" />
        <TextBlock Text="{Binding ScanModeText}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,12,0" />
        <TextBlock Text="{Binding RevocationModeText}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,12,0" />
        <TextBlock Text="{Binding ConcurrencyText}" Style="{StaticResource CaptionTextStyle}" />
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource StatusBarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,14,0" />

        <Grid Grid.Column="1" Margin="0,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding CurrentDirectoryText}"
                     TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryForegroundBrush}"
                     ToolTip="{Binding CurrentDirectory}" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding CurrentFileText}"
                     TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryForegroundBrush}"
                     ToolTip="{Binding CurrentFile}" />
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock Text="{Binding HashProgressText}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                     Margin="0,0,10,0" VerticalAlignment="Center" />
          <ProgressBar Width="150" Value="{Binding ProgressValue, Mode=OneWay}" Minimum="0" Maximum="100"
                       VerticalAlignment="Center" />
          <TextBlock Text="{Binding ElapsedDisplayText}"
                     Foreground="{DynamicResource SecondaryForegroundBrush}"
                     Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding TotalCountText}" Margin="0,0,10,0"
                     Foreground="{DynamicResource SecondaryForegroundBrush}" />
          <TextBlock Text="{Binding CompletedCountText}" Margin="0,0,10,0"
                     Foreground="{DynamicResource SecondaryForegroundBrush}" />
          <TextBlock Text="{Binding ValidCountText}" Margin="0,0,10,0"
                     Foreground="{DynamicResource SuccessBrush}" />
          <TextBlock Text="{Binding UnsignedCountText}" Margin="0,0,10,0"
                     Foreground="{DynamicResource SecondaryForegroundBrush}" />
          <TextBlock Text="{Binding InvalidCountText}" Margin="0,0,10,0"
                     Foreground="{DynamicResource ErrorBrush}" />
          <TextBlock Text="{Binding UnknownCountText}" Margin="0,0,10,0"
                     Foreground="{DynamicResource WarningBrush}" />
          <TextBlock Text="{Binding FailedCountText}"
                     Foreground="{DynamicResource ErrorBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Margin="10,8">
      <DataGrid x:Name="FilesGrid"
                ItemsSource="{Binding FilesView}"
                ColumnHeaderStyle="{StaticResource ColumnHeaderStyle}"
                CanUserSortColumns="True"
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                FrozenColumnCount="3"
                ContextMenuOpening="FilesGrid_ContextMenuOpening"
                SelectionChanged="FilesGrid_SelectionChanged"
                MouseDoubleClick="FilesGrid_MouseDoubleClick"
                PreviewMouseRightButtonDown="FilesGrid_PreviewMouseRightButtonDown"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">

        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{loc:Tr Context.OpenFile}" Command="{Binding OpenFileCommand}" />
            <MenuItem Header="{loc:Tr Context.OpenContainingFolder}"
                      Command="{Binding OpenContainingFolderCommand}" />
            <MenuItem Header="{loc:Tr Context.RevealInExplorer}"
                      Command="{Binding RevealInExplorerCommand}" />
            <Separator />
            <MenuItem Header="{loc:Tr Context.CopyRow}" Command="{Binding CopySelectedCommand}" />
            <MenuItem Header="{loc:Tr Context.CopyPath}" Command="{Binding CopyPathCommand}" />
            <MenuItem Header="{loc:Tr Context.CopyName}" Command="{Binding CopyNameCommand}" />
            <MenuItem Header="{loc:Tr Context.CopySha1}" Command="{Binding CopySha1Command}" />
            <MenuItem Header="{loc:Tr Context.CopySha256}" Command="{Binding CopySha256Command}" />
            <MenuItem Header="{loc:Tr Context.CopySignature}" Command="{Binding CopySignatureCommand}" />
            <Separator />
            <MenuItem Header="{loc:Tr Context.ShowDetails}" Command="{Binding ShowDetailsCommand}" />
            <MenuItem Header="{loc:Tr Menu.Scan.Rescan}" Command="{Binding RescanSelectedCommand}" />
            <MenuItem Header="{loc:Tr Menu.Scan.RemoveSelected}" Command="{Binding RemoveSelectedCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>

        <DataGrid.Columns>
          <DataGridTextColumn Header="{loc:Tr Column.Index}" helpers:ColumnKey.Key="Index"
                              Binding="{Binding Index}" Width="55" SortMemberPath="Index" />
          <DataGridTextColumn Header="{loc:Tr Column.FileName}" helpers:ColumnKey.Key="FileName"
                              Binding="{Binding FileName}" Width="200"
                              ElementStyle="{StaticResource TruncatedCellStyle}" />
          <DataGridTextColumn Header="{loc:Tr Column.FilePath}" helpers:ColumnKey.Key="FilePath"
                              Binding="{Binding FilePath}" Width="320"
                              ElementStyle="{StaticResource PathCellStyle}" />
          <DataGridTextColumn Header="{loc:Tr Column.Size}" helpers:ColumnKey.Key="Size"
                              Binding="{Binding SizeText}" Width="100" SortMemberPath="SizeBytes" />
          <DataGridTextColumn Header="{loc:Tr Column.FileType}" helpers:ColumnKey.Key="FileType"
                              Binding="{Binding FileType}" Width="90" />
          <DataGridTextColumn Header="{loc:Tr Column.LastWriteTime}" helpers:ColumnKey.Key="LastWriteTime"
                              Binding="{Binding LastWriteTimeText}" Width="150"
                              SortMemberPath="LastWriteTime" />
          <DataGridTextColumn Header="{loc:Tr Column.SignatureStatus}" helpers:ColumnKey.Key="SignatureStatus"
                              Binding="{Binding SignatureStatusText}" Width="105"
                              SortMemberPath="SignatureStatusOrder"
                              ElementStyle="{StaticResource SignatureStatusCellStyle}" />
          <DataGridTextColumn Header="{loc:Tr Column.Signer}" helpers:ColumnKey.Key="Signer"
                              Binding="{Binding SignerNames}" Width="180"
                              ElementStyle="{StaticResource TruncatedCellStyle}" />
          <DataGridTextColumn Header="{loc:Tr Column.Issuer}" helpers:ColumnKey.Key="Issuer"
                              Binding="{Binding IssuerNames}" Width="180"
                              ElementStyle="{StaticResource TruncatedCellStyle}" />
          <DataGridTextColumn Header="{loc:Tr Column.Validity}" helpers:ColumnKey.Key="Validity"
                              Binding="{Binding ValidityText}" Width="210"
                              ElementStyle="{StaticResource TruncatedCellStyle}" />
          <DataGridTextColumn Header="{loc:Tr Column.Sha1}" helpers:ColumnKey.Key="Sha1"
                              Binding="{Binding Sha1Text}" Width="300"
                              ElementStyle="{StaticResource ShaCellStyle}" />
          <DataGridTextColumn Header="{loc:Tr Column.Sha256}" helpers:ColumnKey.Key="Sha256"
                              Binding="{Binding Sha256Text}" Width="360"
                              ElementStyle="{StaticResource ShaCellStyle}" />
          <DataGridTextColumn Header="{loc:Tr Column.ScanStatus}" helpers:ColumnKey.Key="ScanStatus"
                              Binding="{Binding ScanStatusText}" Width="95"
                              SortMemberPath="ScanStatusOrder"
                              ElementStyle="{StaticResource ScanStatusCellStyle}" />
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Text="{loc:Tr Filter.EmptyHint}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="16"
                 Foreground="{DynamicResource MutedForegroundBrush}"
                 IsHitTestVisible="False"
                 Visibility="{Binding FilesView.IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

  </DockPanel>
</Window>
