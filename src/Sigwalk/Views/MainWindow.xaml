<Window x:Class="Sigwalk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Sigwalk.Converters"
        Title="Sigwalk - 文件数字签名检测"
        Width="1500"
        Height="820"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Loaded="Window_Loaded"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFilesCommand}" />
    <KeyBinding Key="O" Modifiers="Ctrl+Shift" Command="{Binding OpenDirectoryCommand}" />
    <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PastePathsCommand}" />
    <KeyBinding Key="F5" Command="{Binding StartScanCommand}" />
    <KeyBinding Key="F6" Command="{Binding PauseResumeCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CancelScanCommand}" />
    <KeyBinding Key="Delete" Command="{Binding RemoveSelectedCommand}" />
    <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopySelectedCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveResultsCommand}" />
  </Window.InputBindings>

  <Window.Resources>
    <conv:SignatureStatusToBrushConverter x:Key="SignatureStatusBrush" />
    <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility" />
    <conv:EmptyToDashConverter x:Key="EmptyToDash" />

    <Style x:Key="ColumnHeaderStyle"
           TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource DataGridColumnHeaderBaseStyle}">
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="ColumnHeader_PreviewMouseRightButtonDown" />
    </Style>

    <Style x:Key="PathCellStyle" TargetType="TextBlock">
      <Setter Property="ToolTip" Value="{Binding FilePath}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ShaCellStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
    </Style>

    <Style x:Key="TruncatedCellStyle" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
    </Style>

    <Style x:Key="SignatureStatusCellStyle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground"
              Value="{Binding SignatureStatus, Converter={StaticResource SignatureStatusBrush}}" />
      <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
    </Style>

    <Style x:Key="ScanStatusCellStyle" TargetType="TextBlock">
      <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
    </Style>
  </Window.Resources>

  <DockPanel>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="文件">
        <MenuItem Header="打开文件…" Command="{Binding OpenFilesCommand}" InputGestureText="Ctrl+O" />
        <MenuItem Header="打开目录…" Command="{Binding OpenDirectoryCommand}" InputGestureText="Ctrl+Shift+O" />
        <Separator />
        <MenuItem Header="添加文件…" Command="{Binding AddFilesCommand}" />
        <MenuItem Header="添加目录…" Command="{Binding AddDirectoryCommand}" />
        <MenuItem Header="粘贴路径" Command="{Binding PastePathsCommand}" InputGestureText="Ctrl+V" />
        <Separator />
        <MenuItem Header="保存结果…" Command="{Binding SaveResultsCommand}" InputGestureText="Ctrl+S" />
        <MenuItem Header="加载结果…" Command="{Binding LoadResultsCommand}" />
        <MenuItem Header="导出全部结果…" Command="{Binding ExportAllCommand}" />
        <MenuItem Header="导出当前过滤结果…" Command="{Binding ExportFilteredCommand}" />
        <Separator />
        <MenuItem Header="清空列表" Command="{Binding ClearListCommand}" />
        <Separator />
        <MenuItem Header="退出" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="扫描">
        <MenuItem Header="开始扫描" Command="{Binding StartScanCommand}" InputGestureText="F5" />
        <MenuItem Header="{Binding PauseResumeText}" Command="{Binding PauseResumeCommand}" InputGestureText="F6" />
        <MenuItem Header="取消扫描" Command="{Binding CancelScanCommand}" InputGestureText="Esc" />
        <Separator />
        <MenuItem Header="重新检测选中" Command="{Binding RescanSelectedCommand}" />
        <MenuItem Header="移除选中" Command="{Binding RemoveSelectedCommand}" InputGestureText="Delete" />
      </MenuItem>
      <MenuItem Header="视图">
        <MenuItem Header="{Binding ThemeText, StringFormat='切换主题（当前：{0}）'}" Command="{Binding ToggleThemeCommand}" />
        <Separator />
        <MenuItem Header="设置…" Command="{Binding ShowSettingsCommand}" />
      </MenuItem>
      <MenuItem Header="帮助">
        <MenuItem Header="打开日志目录" Command="{Binding OpenLogFolderCommand}" />
        <MenuItem Header="关于 Sigwalk" Command="{Binding ShowAboutCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,7">
      <WrapPanel VerticalAlignment="Center">
        <Button Content="打开文件" Command="{Binding OpenFilesCommand}" />
        <Button Content="打开目录" Command="{Binding OpenDirectoryCommand}" />
        <Button Content="添加文件" Command="{Binding AddFilesCommand}" />
        <Button Content="添加目录" Command="{Binding AddDirectoryCommand}" />
        <Button Content="粘贴路径" Command="{Binding PastePathsCommand}" />
        <Border Width="1" Height="20" Margin="4,0,10,0" VerticalAlignment="Center"
                Background="{DynamicResource BorderBrush}" />
        <Button Content="开始扫描" Command="{Binding StartScanCommand}" Style="{StaticResource AccentButtonStyle}" />
        <Button Content="{Binding PauseResumeText}" Command="{Binding PauseResumeCommand}" />
        <Button Content="取消扫描" Command="{Binding CancelScanCommand}" />
        <Button Content="重新检测" Command="{Binding RescanSelectedCommand}" />
        <Button Content="查看详情" Command="{Binding ShowDetailsCommand}" />
        <Button Content="移除选中" Command="{Binding RemoveSelectedCommand}" />
        <Button Content="清空" Command="{Binding ClearListCommand}" />
        <Border Width="1" Height="20" Margin="4,0,10,0" VerticalAlignment="Center"
                Background="{DynamicResource BorderBrush}" />
        <Button Content="导出全部" Command="{Binding ExportAllCommand}" />
        <Button Content="保存结果" Command="{Binding SaveResultsCommand}" />
        <Button Content="加载结果" Command="{Binding LoadResultsCommand}" />
        <Button Content="设置" Command="{Binding ShowSettingsCommand}" />
        <Border Width="1" Height="20" Margin="4,0,10,0" VerticalAlignment="Center"
                Background="{DynamicResource BorderBrush}" />
        <CheckBox Content="递归子目录" IsChecked="{Binding Recursive}" Margin="2,0,12,0" VerticalAlignment="Center" />
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="签名状态" Style="{StaticResource CaptionTextStyle}" />
        <ComboBox Width="130" Margin="0,0,12,0"
                  ItemsSource="{Binding FilterOptions}"
                  DisplayMemberPath="Display"
                  SelectedItem="{Binding SelectedFilter}" />
        <TextBlock Text="扩展名" Style="{StaticResource CaptionTextStyle}" />
        <TextBox Width="130" Margin="0,0,12,0"
                 Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="例如 exe;dll;sys；留空表示全部类型" />
        <TextBlock Text="搜索" Style="{StaticResource CaptionTextStyle}" />
        <TextBox x:Name="SearchBox" Width="300" Margin="0,0,8,0"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="搜索文件名、完整路径、签名者、SHA1、SHA256（Ctrl+F 聚焦）" />
        <Button Content="清除过滤" Command="{Binding ClearFiltersCommand}" />
        <TextBlock Text="{Binding VisibleCount, StringFormat='显示 {0} 个文件'}"
                   Style="{StaticResource CaptionTextStyle}"
                   Margin="12,0,0,0" />
        <Border Width="1" Height="18" Margin="12,0,12,0" VerticalAlignment="Center"
                Background="{DynamicResource BorderBrush}" />
        <TextBlock Text="{Binding ScanModeText}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,12,0" />
        <TextBlock Text="{Binding RevocationModeText}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,12,0" />
        <TextBlock Text="{Binding ConcurrencyText}" Style="{StaticResource CaptionTextStyle}" />
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource StatusBarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,14,0" />

        <Grid Grid.Column="1" Margin="0,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding CurrentDirectory, StringFormat='目录: {0}'}"
                     TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryForegroundBrush}"
                     ToolTip="{Binding CurrentDirectory}" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding CurrentFile, StringFormat='文件: {0}'}"
                     TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryForegroundBrush}"
                     ToolTip="{Binding CurrentFile}" />
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock Text="{Binding HashProgressText}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                     Margin="0,0,10,0" VerticalAlignment="Center" />
          <ProgressBar Width="150" Value="{Binding ProgressValue, Mode=OneWay}" Minimum="0" Maximum="100"
                       VerticalAlignment="Center" />
          <TextBlock Text="{Binding ElapsedText, StringFormat='耗时 {0}'}"
                     Foreground="{DynamicResource SecondaryForegroundBrush}"
                     Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding TotalCount, StringFormat='总数 {0}'}" Margin="0,0,10,0"
                     Foreground="{DynamicResource SecondaryForegroundBrush}" />
          <TextBlock Text="{Binding CompletedCount, StringFormat='完成 {0}'}" Margin="0,0,10,0"
                     Foreground="{DynamicResource SecondaryForegroundBrush}" />
          <TextBlock Text="{Binding ValidCount, StringFormat='有效 {0}'}" Margin="0,0,10,0"
                     Foreground="{DynamicResource SuccessBrush}" />
          <TextBlock Text="{Binding UnsignedCount, StringFormat='未签名 {0}'}" Margin="0,0,10,0"
                     Foreground="{DynamicResource SecondaryForegroundBrush}" />
          <TextBlock Text="{Binding InvalidCount, StringFormat='无效 {0}'}" Margin="0,0,10,0"
                     Foreground="{DynamicResource ErrorBrush}" />
          <TextBlock Text="{Binding UnknownCount, StringFormat='未知 {0}'}" Margin="0,0,10,0"
                     Foreground="{DynamicResource WarningBrush}" />
          <TextBlock Text="{Binding FailedCount, StringFormat='失败 {0}'}"
                     Foreground="{DynamicResource ErrorBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Margin="10,8">
      <DataGrid x:Name="FilesGrid"
                ItemsSource="{Binding FilesView}"
                ColumnHeaderStyle="{StaticResource ColumnHeaderStyle}"
                CanUserSortColumns="True"
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                FrozenColumnCount="3"
                ContextMenuOpening="FilesGrid_ContextMenuOpening"
                SelectionChanged="FilesGrid_SelectionChanged"
                MouseDoubleClick="FilesGrid_MouseDoubleClick"
                PreviewMouseRightButtonDown="FilesGrid_PreviewMouseRightButtonDown"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">

        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="打开文件" Command="{Binding OpenFileCommand}" />
            <MenuItem Header="打开文件所在目录" Command="{Binding OpenContainingFolderCommand}" />
            <MenuItem Header="在资源管理器中定位" Command="{Binding RevealInExplorerCommand}" />
            <Separator />
            <MenuItem Header="复制选中行" Command="{Binding CopySelectedCommand}" />
            <MenuItem Header="复制文件路径" Command="{Binding CopyPathCommand}" />
            <MenuItem Header="复制文件名称" Command="{Binding CopyNameCommand}" />
            <MenuItem Header="复制 SHA1" Command="{Binding CopySha1Command}" />
            <MenuItem Header="复制 SHA256" Command="{Binding CopySha256Command}" />
            <MenuItem Header="复制签名信息" Command="{Binding CopySignatureCommand}" />
            <Separator />
            <MenuItem Header="查看完整证书信息" Command="{Binding ShowDetailsCommand}" />
            <MenuItem Header="重新检测选中文件" Command="{Binding RescanSelectedCommand}" />
            <MenuItem Header="移除选中" Command="{Binding RemoveSelectedCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>

        <DataGrid.Columns>
          <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="55" SortMemberPath="Index" />
          <DataGridTextColumn Header="文件名称" Binding="{Binding FileName}" Width="200"
                              ElementStyle="{StaticResource TruncatedCellStyle}" />
          <DataGridTextColumn Header="文件路径" Binding="{Binding FilePath}" Width="320"
                              ElementStyle="{StaticResource PathCellStyle}" />
          <DataGridTextColumn Header="文件大小" Binding="{Binding SizeText}" Width="100"
                              SortMemberPath="SizeBytes" />
          <DataGridTextColumn Header="文件类型" Binding="{Binding FileType}" Width="90" />
          <DataGridTextColumn Header="修改时间" Binding="{Binding LastWriteTimeText}" Width="150"
                              SortMemberPath="LastWriteTime" />
          <DataGridTextColumn Header="签名状态" Binding="{Binding SignatureStatusText}" Width="105"
                              SortMemberPath="SignatureStatusOrder"
                              ElementStyle="{StaticResource SignatureStatusCellStyle}" />
          <DataGridTextColumn Header="签名者" Binding="{Binding SignerNames}" Width="180"
                              ElementStyle="{StaticResource TruncatedCellStyle}" />
          <DataGridTextColumn Header="证书颁发者" Binding="{Binding IssuerNames}" Width="180"
                              ElementStyle="{StaticResource TruncatedCellStyle}" />
          <DataGridTextColumn Header="证书有效期" Binding="{Binding ValidityText}" Width="210"
                              ElementStyle="{StaticResource TruncatedCellStyle}" />
          <DataGridTextColumn Header="SHA1" Binding="{Binding Sha1Text}" Width="300"
                              ElementStyle="{StaticResource ShaCellStyle}" />
          <DataGridTextColumn Header="SHA256" Binding="{Binding Sha256Text}" Width="360"
                              ElementStyle="{StaticResource ShaCellStyle}" />
          <DataGridTextColumn Header="扫描状态" Binding="{Binding ScanStatusText}" Width="95"
                              SortMemberPath="ScanStatusOrder"
                              ElementStyle="{StaticResource ScanStatusCellStyle}" />
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Text="将文件或目录拖放到此处，或使用“打开文件 / 打开目录 / 粘贴路径”"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="16"
                 Foreground="{DynamicResource MutedForegroundBrush}"
                 IsHitTestVisible="False"
                 Visibility="{Binding FilesView.IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

  </DockPanel>
</Window>
