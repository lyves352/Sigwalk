<Window x:Class="Sigwalk.Views.FileDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Sigwalk.Converters"
        Title="文件详情"
        Width="1050"
        Height="820"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Window.Resources>
    <conv:SignatureStatusToBrushConverter x:Key="SignatureStatusBrush" />
    <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility" />
    <conv:EmptyToDashConverter x:Key="EmptyToDash" />

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
      <Setter Property="Margin" Value="0,0,10,6" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="FieldValueStyle" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,20,6" />
    </Style>

    <Style x:Key="MonoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldValueStyle}">
      <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">

    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{Binding FileName}" FontSize="20" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                   TextWrapping="Wrap" Margin="0,2,0,0" />
        <WrapPanel Margin="0,8,0,0">
          <TextBlock Text="签名状态：" Foreground="{DynamicResource SecondaryForegroundBrush}" />
          <TextBlock Text="{Binding SignatureStatusText}" FontWeight="SemiBold" Margin="0,0,18,0" />
          <TextBlock Text="扫描状态：" Foreground="{DynamicResource SecondaryForegroundBrush}" />
          <TextBlock Text="{Binding ScanStatusText}" FontWeight="SemiBold" Margin="0,0,18,0" />
          <TextBlock Text="{Binding SignatureCountText}" Foreground="{DynamicResource SecondaryForegroundBrush}" />
        </WrapPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" VerticalAlignment="Top">
        <Button Content="复制路径" Command="{Binding CopyPathCommand}" MinWidth="110" />
        <Button Content="复制签名信息" Command="{Binding CopySignatureCommand}" MinWidth="110" />
        <Button Content="关闭" Style="{StaticResource AccentButtonStyle}" Click="Close_Click"
                MinWidth="110" Margin="0" IsDefault="True" />
      </StackPanel>
    </Grid>

    <TabControl>

      <TabItem Header="基本信息">
        <Border Background="{DynamicResource PanelBackgroundBrush}" Padding="14">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding BasicFields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource FieldLabelStyle}" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource FieldValueStyle}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="说明：本版本仅检测嵌入式 Authenticode 签名，Windows 目录签名（Catalog）不在检测范围内。"
                         Foreground="{DynamicResource MutedForegroundBrush}"
                         TextWrapping="Wrap"
                         Margin="0,14,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>

      <TabItem Header="签名信息">
        <Border Background="{DynamicResource PanelBackgroundBrush}" Padding="14">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

              <TextBlock Text="{Binding SignatureWarning}"
                         Foreground="{DynamicResource WarningBrush}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8"
                         Visibility="{Binding SignatureWarning, Converter={StaticResource NotEmptyToVisibility}}" />

              <TextBlock Text="{Binding SignatureError}"
                         Foreground="{DynamicResource ErrorBrush}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8"
                         Visibility="{Binding SignatureError, Converter={StaticResource NotEmptyToVisibility}}" />

              <TextBlock Text="文件没有嵌入式数字签名。"
                         Foreground="{DynamicResource SecondaryForegroundBrush}"
                         FontSize="14"
                         Margin="0,20,0,0"
                         Visibility="{Binding HasSignatures, Converter={StaticResource InverseBoolVisibility}}" />

              <ItemsControl ItemsSource="{Binding Signatures}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                      <StackPanel>

                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right"
                                     Text="{Binding StatusText}"
                                     FontWeight="SemiBold"
                                     Foreground="{Binding Status, Converter={StaticResource SignatureStatusBrush}}"
                                     Margin="12,0,0,0" />
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </DockPanel>

                        <TextBlock Text="{Binding Warning}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding Warning, Converter={StaticResource NotEmptyToVisibility}}" />

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}" />

                        <Grid Margin="0,10,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                          <TextBlock Grid.Row="0" Grid.Column="0" Text="签名者" Style="{StaticResource FieldLabelStyle}" />
                          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Certificate.SubjectName, Converter={StaticResource EmptyToDash}}" Style="{StaticResource FieldValueStyle}" />
                          <TextBlock Grid.Row="0" Grid.Column="2" Text="颁发者" Style="{StaticResource FieldLabelStyle}" />
                          <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Certificate.IssuerName, Converter={StaticResource EmptyToDash}}" Style="{StaticResource FieldValueStyle}" />

                          <TextBlock Grid.Row="1" Grid.Column="0" Text="证书主体" Style="{StaticResource FieldLabelStyle}" />
                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Certificate.Subject, Converter={StaticResource EmptyToDash}}" Style="{StaticResource FieldValueStyle}" />
                          <TextBlock Grid.Row="1" Grid.Column="2" Text="证书颁发者" Style="{StaticResource FieldLabelStyle}" />
                          <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Certificate.Issuer, Converter={StaticResource EmptyToDash}}" Style="{StaticResource FieldValueStyle}" />

                          <TextBlock Grid.Row="2" Grid.Column="0" Text="序列号" Style="{StaticResource FieldLabelStyle}" />
                          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Certificate.SerialNumber, Converter={StaticResource EmptyToDash}}" Style="{StaticResource MonoValueStyle}" />
                          <TextBlock Grid.Row="2" Grid.Column="2" Text="指纹" Style="{StaticResource FieldLabelStyle}" />
                          <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Certificate.Thumbprint, Converter={StaticResource EmptyToDash}}" Style="{StaticResource MonoValueStyle}" />

                          <TextBlock Grid.Row="3" Grid.Column="0" Text="有效期" Style="{StaticResource FieldLabelStyle}" />
                          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Certificate.ValidityText, Converter={StaticResource EmptyToDash}}" Style="{StaticResource FieldValueStyle}" />
                          <TextBlock Grid.Row="3" Grid.Column="2" Text="吊销状态" Style="{StaticResource FieldLabelStyle}" />
                          <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Certificate.RevocationStatusText, Converter={StaticResource EmptyToDash}}" Style="{StaticResource FieldValueStyle}" />

                          <TextBlock Grid.Row="4" Grid.Column="0" Text="证书算法" Style="{StaticResource FieldLabelStyle}" />
                          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Certificate.SignatureAlgorithm, Converter={StaticResource EmptyToDash}}" Style="{StaticResource FieldValueStyle}" />
                          <TextBlock Grid.Row="4" Grid.Column="2" Text="证书链" Style="{StaticResource FieldLabelStyle}" />
                          <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding Certificate.ChainStatusText, Converter={StaticResource EmptyToDash}}" Style="{StaticResource FieldValueStyle}" />

                          <TextBlock Grid.Row="5" Grid.Column="0" Text="签名算法" Style="{StaticResource FieldLabelStyle}" />
                          <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SignatureAlgorithm, Converter={StaticResource EmptyToDash}}" Style="{StaticResource FieldValueStyle}" />
                          <TextBlock Grid.Row="5" Grid.Column="2" Text="摘要算法" Style="{StaticResource FieldLabelStyle}" />
                          <TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding DigestAlgorithm, Converter={StaticResource EmptyToDash}}" Style="{StaticResource FieldValueStyle}" />

                          <TextBlock Grid.Row="6" Grid.Column="0" Text="时间戳" Style="{StaticResource FieldLabelStyle}" />
                          <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldValueStyle}">
                            <Run Text="{Binding Timestamp.Type, Mode=OneWay, TargetNullValue=—, FallbackValue=—}" />
                            <Run Text="  " />
                            <Run Text="{Binding Timestamp.TimestampText, Mode=OneWay, FallbackValue=—}" />
                          </TextBlock>
                          <TextBlock Grid.Row="6" Grid.Column="2" Text="时间戳签名者" Style="{StaticResource FieldLabelStyle}" />
                          <TextBlock Grid.Row="6" Grid.Column="3" Text="{Binding Timestamp.SignerName, Converter={StaticResource EmptyToDash}}" Style="{StaticResource FieldValueStyle}" />
                        </Grid>

                        <TextBlock Text="验证方式" Style="{StaticResource FieldLabelStyle}" Margin="0,6,0,4" />
                        <Grid>
                          <TextBlock Text="WinVerifyTrust 系统验证"
                                     Visibility="{Binding IsVerified, Converter={StaticResource BoolToVisibility}}" />
                          <TextBlock Text="仅展示（未单独验证）"
                                     Foreground="{DynamicResource WarningBrush}"
                                     Visibility="{Binding IsVerified, Converter={StaticResource InverseBoolVisibility}}" />
                        </Grid>

                        <TextBlock Text="证书链" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4" />
                        <ItemsControl ItemsSource="{Binding Chain}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" FontSize="12">
                                <Run Text="{Binding Index, Mode=OneWay}" />
                                <Run Text=". " />
                                <Run Text="{Binding Subject, Mode=OneWay}" />
                                <Run Text="  →  " />
                                <Run Text="{Binding Issuer, Mode=OneWay}" />
                                <Run Text="  [" />
                                <Run Text="{Binding StatusText, Mode=OneWay}" />
                                <Run Text="]" />
                              </TextBlock>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>

      <TabItem Header="哈希">
        <Border Background="{DynamicResource PanelBackgroundBrush}" Padding="16">
          <StackPanel>
            <TextBlock Text="SHA1" FontWeight="SemiBold" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,18">
              <Button DockPanel.Dock="Right" Content="复制 SHA1" Command="{Binding CopySha1Command}"
                      Margin="8,0,0,0" />
              <TextBox Text="{Binding Sha1Text, Mode=OneWay}" IsReadOnly="True"
                       FontFamily="Consolas, Cascadia Mono, Courier New" TextWrapping="Wrap" />
            </DockPanel>

            <TextBlock Text="SHA256" FontWeight="SemiBold" Margin="0,0,0,4" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="复制 SHA256" Command="{Binding CopySha256Command}"
                      Margin="8,0,0,0" />
              <TextBox Text="{Binding Sha256Text, Mode=OneWay}" IsReadOnly="True"
                       FontFamily="Consolas, Cascadia Mono, Courier New" TextWrapping="Wrap" />
            </DockPanel>

            <TextBlock Text="哈希值统一使用大写十六进制格式。"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Margin="0,18,0,0" />
          </StackPanel>
        </Border>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
