<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Sigwalk.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 仅用于获取 SignedCms / Rfc3161TimestampToken（WindowsDesktop 共享框架已包含，无需额外 NuGet） -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置双语字符串表；不使用 satellite 程序集，兼容单文件发布 -->
    <EmbeddedResource Include="Localization\zh-Hans.json"
                      LogicalName="Sigwalk.Core.Localization.zh-Hans.json" />
    <EmbeddedResource Include="Localization\en-US.json"
                      LogicalName="Sigwalk.Core.Localization.en-US.json" />
  </ItemGroup>

</Project>
